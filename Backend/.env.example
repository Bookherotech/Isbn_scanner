
# MySQL 8.4+ (Django 6.1 needs 8.4 or newer)
DB_NAME=bookhero
DB_USER=bookhero
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
# First-time setup: after filling the DB_* values, run  py manage.py setup_database
# It creates the database and this user, and asks for the MySQL root password
# (or reads DB_ROOT_PASSWORD from the environment). Never save the root password in .env.

# Email (sends the Super Admin sign-in code). Leave EMAIL_HOST empty to only print emails in the terminal.
# Gmail: turn on 2-Step Verification, then create an App password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-letter-app-password
# Optional; defaults to "BookHero <EMAIL_HOST_USER>"
# DEFAULT_FROM_EMAIL=BookHero <your-address@gmail.com>

# Store timezone: where "today" starts for daily counts
STORE_TIME_ZONE=Asia/Dubai

# Book metadata lookup. Providers are asked in this order (first match wins): openlibrary, google
METADATA_PROVIDERS=openlibrary,google
# Google Books key: needed for Google (keyless requests are refused) and for the title suggestions.
# Create one at https://console.cloud.google.com/apis/library/books.googleapis.com and restrict it to the Books API.
GOOGLE_BOOKS_API_KEY=
# METADATA_TIMEOUT_SECONDS=5
